# Copier ce fichier en ".env" puis renseigner les valeurs.
# Utilise uniquement par "docker compose --profile selfhost".

# OBLIGATOIRE. Secret de signature des jetons de session (JWT).
# Generer une chaine aleatoire longue, par ex. :
#   openssl rand -base64 48
JWT_SECRET=

# Mot de passe de la base PostgreSQL (defaut : ebiosrm_dev).
POSTGRES_PASSWORD=ebiosrm_dev

# Port d'ecoute du site sur la machine hote (defaut : 8080).
#   -> application accessible sur http://localhost:8080
WEB_PORT=8080

# URL publique du site, utilisee dans les liens des emails
# (reinitialisation de mot de passe). Adapter si acces distant / nom de domaine.
APP_URL=http://localhost:8080
