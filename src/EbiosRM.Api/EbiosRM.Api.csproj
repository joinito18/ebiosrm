<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Polices des rapports PDF, embarquees dans l'assembly (cf. Program.cs) :
         fonctionne aussi en publication fichier unique. -->
    <EmbeddedResource Include="Assets\Fonts\*.ttf" />
    <!-- Etude d'exemple deposee au 1er lancement du .exe (cf.
         ConfigurationExecution). Genere par build/seed/generer-seed.sh,
         absent du depot par defaut -> l'inclusion est conditionnelle. -->
    <EmbeddedResource Include="ressources\ebiosrm.seed.db" Condition="Exists('ressources\ebiosrm.seed.db')" />
    <!-- Guides d'utilisation : source unique partagee avec le frontend
         (frontend/src/guides/*.md). Embarques pour le manuel PDF (/aide/manuel.pdf). -->
    <EmbeddedResource Include="..\..\frontend\src\guides\*.md">
      <LogicalName>Guides.fr.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\frontend\src\guides\en\*.md">
      <LogicalName>Guides.en.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
